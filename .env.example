# =============================================================================
# AIアバター自動マッチング — 環境変数
# docs/02-architecture.md §6 を参照
# =============================================================================

# --- Supabase --------------------------------------------------------------
# Supabase プロジェクトURL。ブラウザに公開される
NEXT_PUBLIC_SUPABASE_URL=

# Supabase anon キー。ブラウザに公開される(RLSにより保護される)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service_role キー。RLSを迂回する。
# 絶対に NEXT_PUBLIC_ を付けない。バッチ処理と招待コード検証のみで使用する
SUPABASE_SERVICE_ROLE_KEY=

# --- Claude API (Anthropic) -------------------------------------------------
# Claude APIキー。未設定の場合は決定的フォールバックで全画面が動作する(NFR-4)
ANTHROPIC_API_KEY=

# アバター間会話生成に使うモデル。既定 claude-sonnet-5
ANTHROPIC_MODEL_CONVERSATION=claude-sonnet-5

# 相性評価に使うモデル。既定 claude-opus-5
ANTHROPIC_MODEL_EVALUATION=claude-opus-5

# --- バッチ (cron) -----------------------------------------------------------
# /api/cron/matching を保護するシークレット。未設定の場合は常に401を返す
CRON_SECRET=

# 通知を作成する総合スコアの閾値。既定 75
MATCH_NOTIFY_THRESHOLD=75

# バッチ1回の実行で処理する候補数の上限。既定 20
MATCH_BATCH_LIMIT=20

# 1参加者あたりの未判断マッチ数の上限。既定 3
MAX_OPEN_MATCHES_PER_PROFILE=3
